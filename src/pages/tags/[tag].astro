---
import { sanityClient, urlFor } from "../../lib/sanity";

export async function getStaticPaths() {
  const tags = await sanityClient.fetch(`
    *[
      _type == "tag" &&
      defined(name)
    ] {
      name
    }
  `);

  function makeTagSlug(value) {
    return value
      .trim()
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[^a-z0-9-]/g, "");
  }

  return tags.map((tag) => ({
    params: {
      tag: makeTagSlug(tag.name)
    },

    props: {
      tagName: tag.name
    }
  }));
}

const tagName = Astro.props.tagName;

const articles = await sanityClient.fetch(
  `
    *[
      _type == "article" &&
      defined(slug.current) &&
      $tagName in tags[]->name
    ]
    | order(date desc) {
      title,
      "slug": slug.current,
      date,
      location,
      description,
      cover,
      "tags": tags[]->name
    }
  `,
  {
    tagName
  }
);

const base = import.meta.env.BASE_URL;

function slugifyTag(tag) {
  return tag
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

function formatDate(date) {
  return new Date(
    date + "T00:00:00Z"
  )
    .toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      timeZone: "UTC"
    })
    .toUpperCase();
}

const entries = articles.map((article) => ({
  slug: article.slug,

  title: article.title,

  date: formatDate(
    article.date
  ),

  location:
    article.location || "",

  description:
    article.description || "",

  tags:
    article.tags || [],

  cover: article.cover
    ? urlFor(article.cover)
        .width(1000)
        .url()
    : ""
}));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      #{tagName} — for the record
    </title>

    <meta
      name="description"
      content={`Articles tagged ${tagName}`}
    />
  </head>

  <body>
    <header class="site-header">
      <a
        href={base}
        class="logo"
      >
        for the record
      </a>

      <a
        href={base}
        class="back"
      >
        BACK
      </a>
    </header>

    <main class="site-main">
      <section class="tag-section">
        <div class="tag-header">
          <h1>
            #{tagName.toUpperCase()}
          </h1>

          <div class="article-count">
            {
              entries.length === 1
                ? "1 ARTICLE"
                : `${entries.length} ARTICLES`
            }
          </div>
        </div>

        {
          entries.length > 0 ? (
            <div class="entries">
              {
                entries.map((entry) => (
                  <article class="entry-card">
                    <a
                      href={`${base}journal/${entry.slug}/`}
                      class="entry-link"
                    >
                      <div class="entry-image">
                        {
                          entry.cover ? (
                            <img
                              src={entry.cover}
                              alt={entry.title}
                              loading="lazy"
                            />
                          ) : (
                            <span>
                              PHOTO
                            </span>
                          )
                        }
                      </div>

                      <div class="entry-date">
                        {entry.date}
                      </div>

                      <h2 class="entry-title">
                        {entry.title}
                      </h2>

                      {
                        entry.location && (
                          <div class="entry-location">
                            {entry.location}
                          </div>
                        )
                      }
                    </a>

                    {
                      entry.tags.length > 0 && (
                        <div class="entry-tags">
                          {
                            entry.tags.map(
                              (entryTag) => (
                                <a
                                  href={`${base}tags/${slugifyTag(entryTag)}/`}
                                  class="tag"
                                >
                                  #{entryTag}
                                </a>
                              )
                            )
                          }
                        </div>
                      )
                    }

                    {
                      entry.description && (
                        <p class="entry-description">
                          {entry.description}
                        </p>
                      )
                    }
                  </article>
                ))
              }
            </div>
          ) : (
            <div class="empty">
              NO ARTICLES
            </div>
          )
        }
      </section>
    </main>

    <footer class="site-footer">
      <span>
        FOR THE RECORD
      </span>

      <span>
        © 2026
      </span>
    </footer>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        margin: 0;
        padding: 0;

        background: #ffffff;
      }

      :global(body) {
        margin: 0;
        padding: 0;

        background: #ffffff;
        color: #111111;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        -webkit-font-smoothing:
          antialiased;
      }

      .site-header {
        width:
          calc(100% - 80px);

        max-width: 1440px;
        height: 56px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content:
          space-between;

        border-bottom:
          1px solid #e5e5e5;
      }

      .logo {
        color: #111111;
        text-decoration: none;

        font-size: 14px;
        letter-spacing:
          -0.02em;
      }

      .back {
        color: #111111;
        text-decoration: none;

        font-size: 9px;
        letter-spacing:
          0.08em;
      }

      .site-main {
        width:
          calc(100% - 80px);

        max-width: 1440px;

        margin: 0 auto;
      }

      .tag-section {
        padding:
          60px 0
          110px;
      }

      .tag-header {
        display: flex;
        align-items: flex-end;
        justify-content:
          space-between;

        margin-bottom: 50px;
      }

      h1 {
        margin: 0;

        font-size: 42px;
        font-weight: 400;

        letter-spacing:
          -0.04em;

        line-height: 1;
      }

      .article-count {
        color: #777777;

        font-size: 9px;
        letter-spacing:
          0.06em;
      }

      .entries {
        display: grid;

        grid-template-columns:
          repeat(
            4,
            minmax(0, 1fr)
          );

        column-gap: 24px;
        row-gap: 70px;
      }

      .entry-card {
        min-width: 0;
      }

      .entry-link {
        display: block;

        color: inherit;
        text-decoration: none;
      }

      .entry-image {
        width: 100%;

        aspect-ratio:
          1 / 0.78;

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: hidden;

        background: #f4f4f4;
      }

      .entry-image img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
      }

      .entry-image span {
        color: #999999;

        font-size: 9px;
        letter-spacing:
          0.08em;
      }

      .entry-date {
        margin-top: 16px;

        color: #777777;

        font-size: 9px;
        letter-spacing:
          0.04em;
      }

      .entry-title {
        margin:
          8px 0
          0;

        font-size: 17px;
        font-weight: 400;

        letter-spacing:
          -0.02em;

        line-height: 1.3;
      }

      .entry-location {
        margin-top: 9px;

        color: #777777;

        font-size: 9px;
        letter-spacing:
          0.04em;
      }

      .entry-tags {
        display: flex;
        flex-wrap: wrap;

        gap: 8px;

        margin-top: 10px;
      }

      .tag {
        color: #777777;
        text-decoration: none;

        font-size: 9px;
        letter-spacing:
          0.03em;
      }

      .tag:hover {
        color: #111111;
      }

      .entry-description {
        max-width: 340px;

        margin:
          13px 0
          0;

        color: #444444;

        font-size: 12px;
        line-height: 1.6;
      }

      .empty {
        padding:
          70px 0;

        color: #777777;

        font-size: 10px;
        letter-spacing:
          0.08em;
      }

      .site-footer {
        width:
          calc(100% - 80px);

        max-width: 1440px;

        margin: 0 auto;

        padding:
          25px 0
          28px;

        border-top:
          1px solid #e5e5e5;

        display: flex;
        justify-content:
          space-between;

        color: #777777;

        font-size: 9px;
        letter-spacing:
          0.06em;
      }

      @media (
        max-width: 1000px
      ) {
        .entries {
          grid-template-columns:
            repeat(
              2,
              minmax(0, 1fr)
            );
        }
      }

      @media (
        max-width: 600px
      ) {
        .site-header,
        .site-main,
        .site-footer {
          width:
            calc(100% - 40px);
        }

        .tag-section {
          padding-top: 40px;
        }

        .tag-header {
          align-items:
            flex-start;

          flex-direction:
            column;

          gap: 15px;

          margin-bottom: 35px;
        }

        h1 {
          font-size: 36px;
        }

        .entries {
          grid-template-columns:
            1fr;
        }
      }
    </style>
  </body>
</html>