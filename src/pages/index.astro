---
import { getCollection } from "astro:content";

const contentEntries = await getCollection("entries");

const entries = contentEntries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    id: entry.id,
    date: entry.data.date
      .toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      })
      .toUpperCase(),
    title: entry.data.title,
    location: entry.data.location,
    category: entry.data.category,
    description: entry.data.description,
    cover: entry.data.cover || "",
  }));

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>for the record</title>
    <meta
      name="description"
      content="A personal archive of travel, films, food, music, and life."
    />
  </head>

  <body>
    <header class="site-header">
      <a href={base} class="logo">for the record</a>

      <button class="search-button" id="searchToggle" type="button">
        SEARCH
      </button>
    </header>

    <!-- Search -->
    <section class="search-panel" id="searchPanel" aria-hidden="true">
      <div class="search-inner">
        <input
          id="searchInput"
          type="search"
          placeholder="Search entries..."
          autocomplete="off"
        />

        <button id="searchClose" type="button" aria-label="Close search">
          CLOSE
        </button>
      </div>
    </section>

    <main>
      <!-- Categories -->
      <nav class="category-nav" aria-label="Categories">
        <button class="category active" data-category="ALL">ALL</button>
        <button class="category" data-category="TRAVEL">TRAVEL</button>
        <button class="category" data-category="FILM">FILM</button>
        <button class="category" data-category="FOOD">FOOD</button>
        <button class="category" data-category="MUSIC">MUSIC</button>
        <button class="category" data-category="LIFE">LIFE</button>
      </nav>

      <!-- Recent -->
      <section class="recent-section">
        <div class="section-heading">
          <h1>RECENT</h1>
        </div>

        <div class="entries-grid" id="entriesGrid">
          {
            entries.map((entry) => (
              <a
                href={`${base}journal/${entry.id}`}
                class="entry-card"
                data-category={entry.category}
                data-search={`${entry.title} ${entry.location} ${entry.category} ${entry.description}`}
              >
                <div class="entry-image">
                  {entry.cover ? (
                    <img src={entry.cover} alt={entry.title} loading="lazy" />
                  ) : (
                    <span>PHOTO</span>
                  )}
                </div>

                <div class="entry-info">
                  <div class="entry-date">{entry.date}</div>

                  <h2>{entry.title}</h2>

                  <div class="entry-meta">
                    <span>{entry.location}</span>
                    <span>{entry.category}</span>
                  </div>

                  <p>{entry.description}</p>
                </div>
              </a>
            ))
          }
        </div>

        <div class="no-results" id="noResults">
          NO ENTRIES FOUND
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>FOR THE RECORD</div>
      <div>© 2026</div>
    </footer>
  </body>

  <script>
    const searchToggle = document.getElementById("searchToggle");
    const searchPanel = document.getElementById("searchPanel");
    const searchInput = document.getElementById("searchInput");
    const searchClose = document.getElementById("searchClose");

    const categoryButtons = document.querySelectorAll(".category");
    const entryCards = document.querySelectorAll(".entry-card");
    const noResults = document.getElementById("noResults");

    let activeCategory = "ALL";
    let searchTerm = "";

    function updateEntries() {
      let visibleCount = 0;

      entryCards.forEach((card) => {
        const category = card.dataset.category || "";
        const searchText = card.dataset.search || "";

        const categoryMatch =
          activeCategory === "ALL" || category === activeCategory;

        const searchMatch = searchText
          .toLowerCase()
          .includes(searchTerm.toLowerCase());

        if (categoryMatch && searchMatch) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (visibleCount === 0) {
        noResults.classList.add("visible");
      } else {
        noResults.classList.remove("visible");
      }
    }

    function openSearch() {
      searchPanel.classList.add("open");
      searchPanel.setAttribute("aria-hidden", "false");

      setTimeout(() => {
        searchInput?.focus();
      }, 100);
    }

    function closeSearch() {
      searchPanel.classList.remove("open");
      searchPanel.setAttribute("aria-hidden", "true");

      if (searchInput) {
        searchInput.value = "";
      }

      searchTerm = "";
      updateEntries();
    }

    searchToggle?.addEventListener("click", openSearch);
    searchClose?.addEventListener("click", closeSearch);

    searchInput?.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      searchTerm = target.value.trim();
      updateEntries();
    });

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.dataset.category || "ALL";

        activeCategory = category;

        categoryButtons.forEach((item) => {
          item.classList.remove("active");
        });

        button.classList.add("active");

        updateEntries();
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeSearch();
      }
    });

    updateEntries();
  </script>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      margin: 0;
      padding: 0;
      background: #fff;
    }

    :global(body) {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #111;
      font-family:
        -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial,
        sans-serif;
      font-weight: 400;
      letter-spacing: 0;
    }

    :global(button),
    :global(input) {
      font: inherit;
    }

    :global(a) {
      color: inherit;
      text-decoration: none;
    }

    /* =========================
       Header
       ========================= */

    .site-header {
      width: 100%;
      max-width: 1200px;
      height: 88px;
      margin: 0 auto;
      padding: 0 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 16px;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .search-button {
      padding: 0;
      border: 0;
      background: transparent;
      color: #111;
      font-size: 11px;
      letter-spacing: 0.08em;
      cursor: pointer;
    }

    .search-button:hover {
      opacity: 0.5;
    }

    /* =========================
       Search
       ========================= */

    .search-panel {
      display: none;
      border-top: 1px solid #e5e5e5;
      border-bottom: 1px solid #e5e5e5;
    }

    .search-panel.open {
      display: block;
    }

    .search-inner {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px 24px;

      display: flex;
      align-items: center;
      gap: 24px;
    }

    .search-inner input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: #111;
      font-size: 18px;
    }

    .search-inner input::placeholder {
      color: #999;
    }

    .search-inner button {
      flex-shrink: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: #666;
      font-size: 10px;
      letter-spacing: 0.08em;
      cursor: pointer;
    }

    .search-inner button:hover {
      color: #111;
    }

    /* =========================
       Category navigation
       ========================= */

    .category-nav {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 24px;

      display: flex;
      align-items: center;
      gap: 28px;

      border-top: 1px solid #e5e5e5;
      border-bottom: 1px solid #e5e5e5;

      overflow-x: auto;
      scrollbar-width: none;
    }

    .category-nav::-webkit-scrollbar {
      display: none;
    }

    .category {
      flex-shrink: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: #999;

      font-size: 10px;
      letter-spacing: 0.08em;

      cursor: pointer;
    }

    .category:hover {
      color: #111;
    }

    .category.active {
      color: #111;
    }

    /* =========================
       Recent
       ========================= */

    .recent-section {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px 24px 100px;
    }

    .section-heading {
      margin-bottom: 32px;
    }

    .section-heading h1 {
      margin: 0;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    /* =========================
       Entry grid
       ========================= */

    .entries-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 48px 24px;
    }

    .entry-card {
      display: block;
      min-width: 0;
    }

    .entry-card.hidden {
      display: none;
    }

    .entry-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      margin-bottom: 18px;

      display: flex;
      align-items: center;
      justify-content: center;

      background: #f4f4f4;
      overflow: hidden;
    }

    .entry-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .entry-image span {
      color: #aaa;
      font-size: 9px;
      letter-spacing: 0.1em;
    }

    .entry-card:hover .entry-image span {
      color: #777;
    }

    .entry-info {
      min-width: 0;
    }

    .entry-date {
      margin-bottom: 10px;
      color: #999;
      font-size: 9px;
      letter-spacing: 0.06em;
    }

    .entry-info h2 {
      margin: 0 0 8px;

      font-size: 16px;
      line-height: 1.3;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .entry-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;

      margin-bottom: 12px;

      color: #777;
      font-size: 9px;
      letter-spacing: 0.04em;
    }

    .entry-meta span + span::before {
      content: "/";
      margin-right: 8px;
      color: #bbb;
    }

    .entry-info p {
      margin: 0;

      color: #777;
      font-size: 12px;
      line-height: 1.65;
    }

    /* =========================
       No results
       ========================= */

    .no-results {
      display: none;
      padding: 80px 0;
      color: #999;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-align: center;
    }

    .no-results.visible {
      display: block;
    }

    /* =========================
       Footer
       ========================= */

    .site-footer {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;

      display: flex;
      justify-content: space-between;

      border-top: 1px solid #e5e5e5;

      color: #999;
      font-size: 9px;
      letter-spacing: 0.08em;
    }

    /* =========================
       Tablet
       ========================= */

    @media (max-width: 900px) {
      .entries-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* =========================
       Mobile
       ========================= */

    @media (max-width: 560px) {
      .site-header {
        height: 72px;
        padding: 0 18px;
      }

      .category-nav {
        padding: 14px 18px;
        gap: 22px;
      }

      .recent-section {
        padding: 48px 18px 72px;
      }

      .entries-grid {
        grid-template-columns: 1fr;
        gap: 42px;
      }

      .entry-image {
        aspect-ratio: 4 / 3;
      }

      .site-footer {
        padding: 20px 18px;
      }

      .search-inner {
        padding: 18px;
      }
    }
  </style>
</html>