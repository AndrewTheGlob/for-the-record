---
import { getCollection } from "astro:content";

const entries = await getCollection("entries");

const base = import.meta.env.BASE_URL;

function withBase(path: string | undefined) {
  if (!path) return "";

  if (
    path.startsWith("http://") ||
    path.startsWith("https://")
  ) {
    return path;
  }

  return `${base}${path.replace(/^\/+/, "")}`;
}

function slugifyTag(tag: string) {
  return tag
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

const sortedEntries = [...entries].sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime()
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>for the record</title>

    <meta
      name="description"
      content="A personal archive."
    />
  </head>

  <body>

    <header class="site-header">

      <a
        href={base}
        class="logo"
      >
        for the record
      </a>

      <div class="header-right">
        <span>
          {sortedEntries.length}
          {sortedEntries.length === 1
            ? " ENTRY"
            : " ENTRIES"}
        </span>
      </div>

    </header>


    <main>

      <section class="intro">

        <div class="intro-label">
          PERSONAL ARCHIVE
        </div>

        <h1>
          for the record
        </h1>

      </section>


      <section class="entries">

        {
          sortedEntries.map((entry, index) => {

            const {
              title,
              date,
              location,
              description,
              cover,
              tags,
              rating,
            } = entry.data;

            const formattedDate =
              date
                .toLocaleDateString("en-GB", {
                  day: "2-digit",
                  month: "short",
                  year: "numeric",
                })
                .toUpperCase();

            const stars =
              "★".repeat(
                Math.max(
                  0,
                  Math.min(6, Number(rating) || 0)
                )
              ) +
              "☆".repeat(
                6 -
                  Math.max(
                    0,
                    Math.min(6, Number(rating) || 0)
                  )
              );

            return (
              <article class="entry">

                <a
                  href={`${base}journal/${entry.id}/`}
                  class="entry-link"
                >

                  <div class="entry-number">
                    {String(index + 1).padStart(2, "0")}
                  </div>


                  <div class="entry-image">

                    {
                      cover ? (
                        <img
                          src={withBase(cover)}
                          alt={title}
                          loading="lazy"
                        />
                      ) : (
                        <span>
                          PHOTO
                        </span>
                      )
                    }

                  </div>


                  <div class="entry-info">

                    <div class="entry-meta">

                      <span>
                        {formattedDate}
                      </span>

                      {
                        location && (
                          <span>
                            {location}
                          </span>
                        )
                      }

                    </div>


                    <h2>
                      {title}
                    </h2>


                    {
                      description && (
                        <p>
                          {description}
                        </p>
                      )
                    }


                    {
                      tags &&
                      tags.length > 0 && (
                        <div class="entry-tags">

                          {
                            tags.map((tag) => (
                              <span
                                class="tag"
                                onclick={`window.location.href='${base}tags/${slugifyTag(tag)}/'`}
                              >
                                #{tag}
                              </span>
                            ))
                          }

                        </div>
                      )
                    }


                    <div
                      class="entry-rating"
                      aria-label={`Rating: ${rating} out of 6`}
                    >
                      {stars}
                    </div>

                  </div>

                </a>

              </article>
            );
          })
        }

      </section>

    </main>


    <footer class="site-footer">

      <span>
        FOR THE RECORD
      </span>

      <span>
        © 2026
      </span>

    </footer>


    <style>

      :global(*) {
        box-sizing: border-box;
      }


      :global(html) {
        margin: 0;
        padding: 0;
        background: #ffffff;
      }


      :global(body) {
        margin: 0;
        padding: 0;

        background: #ffffff;
        color: #111111;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        -webkit-font-smoothing: antialiased;
      }


      .site-header {
        width: calc(100% - 24px);
        max-width: 1440px;

        height: 45px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e5e5e5;
      }


      .logo {
        color: #111111;
        text-decoration: none;

        font-size: 14px;
        letter-spacing: -0.02em;
      }


      .header-right {
        color: #777777;

        font-size: 9px;
        letter-spacing: 0.06em;
      }


      main {
        width: 100%;
      }


      .intro {
        width: calc(100% - 24px);
        max-width: 1440px;

        margin: 0 auto;

        padding:
          85px 0
          90px;
      }


      .intro-label {
        color: #777777;

        font-size: 9px;
        letter-spacing: 0.08em;
      }


      h1 {
        margin:
          28px 0
          0;

        font-size: clamp(64px, 10vw, 150px);
        font-weight: 400;

        letter-spacing: -0.065em;
        line-height: 0.88;
      }


      .entries {
        width: calc(100% - 24px);
        max-width: 1440px;

        margin: 0 auto;
      }


      .entry {
        border-top: 1px solid #e5e5e5;
      }


      .entry-link {
        display: grid;

        grid-template-columns:
          45px
          minmax(240px, 420px)
          minmax(0, 1fr);

        column-gap: 35px;

        padding:
          35px 0
          40px;

        color: inherit;
        text-decoration: none;
      }


      .entry-number {
        color: #777777;

        font-size: 9px;
        letter-spacing: 0.06em;

        padding-top: 4px;
      }


      .entry-image {
        width: 100%;
        aspect-ratio: 4 / 3;

        background: #f4f4f4;

        overflow: hidden;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #999999;

        font-size: 9px;
        letter-spacing: 0.08em;
      }


      .entry-image img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
      }


      .entry-info {
        padding-top: 2px;
      }


      .entry-meta {
        display: flex;

        gap: 25px;

        color: #777777;

        font-size: 9px;
        letter-spacing: 0.05em;
      }


      h2 {
        margin:
          28px 0
          0;

        font-size: clamp(32px, 4vw, 60px);
        font-weight: 400;

        letter-spacing: -0.045em;
        line-height: 0.95;
      }


      .entry-info p {
        max-width: 600px;

        margin:
          25px 0
          0;

        color: #333333;

        font-size: 13px;
        line-height: 1.7;
      }


      .entry-tags {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 25px;
      }


      .tag {
        color: #666666;

        font-size: 9px;

        letter-spacing: 0.03em;

        cursor: pointer;
      }


      .tag:hover {
        color: #111111;
      }


      .entry-rating {
        margin-top: 22px;

        color: #111111;

        font-size: 15px;

        letter-spacing: 0.12em;

        line-height: 1;
      }


      .site-footer {
        width: calc(100% - 24px);
        max-width: 1440px;

        margin:
          120px auto
          0;

        padding:
          25px 0
          28px;

        border-top: 1px solid #e5e5e5;

        display: flex;

        justify-content: space-between;

        color: #777777;

        font-size: 9px;

        letter-spacing: 0.06em;
      }


      @media (max-width: 900px) {

        .entry-link {
          grid-template-columns:
            35px
            1fr;

          row-gap: 25px;
        }


        .entry-image {
          grid-column: 2;
        }


        .entry-info {
          grid-column: 2;
        }

      }


      @media (max-width: 600px) {

        .site-header {
          width:
            calc(100% - 40px);
        }


        .intro {
          width:
            calc(100% - 40px);

          padding:
            60px 0
            65px;
        }


        .entries {
          width:
            calc(100% - 40px);
        }


        h1 {
          font-size: 58px;
        }


        .entry-link {
          grid-template-columns: 30px 1fr;

          column-gap: 20px;

          padding:
            25px 0
            30px;
        }


        .entry-image {
          grid-column: 2;
        }


        .entry-info {
          grid-column: 2;
        }


        h2 {
          font-size: 38px;
        }

      }

    </style>

  </body>
</html>
