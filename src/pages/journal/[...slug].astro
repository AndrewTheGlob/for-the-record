---
import { sanityClient, urlFor } from "../../lib/sanity";
import { portableTextComponents } from "../../lib/portableText.js";
import { toHTML } from "@portabletext/to-html";

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(`
    *[
      _type == "article" &&
      defined(slug.current)
    ] {
      "slug": slug.current
    }
  `);

  return articles.map((article) => ({
    params: {
      slug: article.slug
    }
  }));
}

const slug = Astro.params.slug;

const article = await sanityClient.fetch(
  `
    *[
      _type == "article" &&
      slug.current == $slug
    ][0] {
      title,
      date,
      location,
      description,
      cover,
      rating,
      body,
      "tags": tags[]->name
    }
  `,
  {
    slug
  }
);

const base = import.meta.env.BASE_URL;

const title = article.title;
const date = article.date;
const location = article.location || "";
const description = article.description || "";
const tags = article.tags || [];
const cover = article.cover;
const body = article.body || [];

const rating = Math.max(
  0,
  Math.min(
    6,
    Math.round(
      Number(article.rating || 0)
    )
  )
);

const formattedDate = new Date(
  date + "T00:00:00Z"
)
  .toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  })
  .toUpperCase();

function slugifyTag(tag) {
  return tag
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

const coverUrl = cover
  ? urlFor(cover)
      .width(1400)
      .url()
  : "";

const coverFullUrl = cover
  ? urlFor(cover).url()
  : "";

const bodyHtml = toHTML(body, {
  components: portableTextComponents
});

const stars =
  "★".repeat(rating) +
  "☆".repeat(6 - rating);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title} — for the record</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <header class="site-header">
      <a
        href={base}
        class="logo"
      >
        for the record
      </a>

      <a
        href={base}
        class="back"
      >
        BACK
      </a>
    </header>

    <main>
      <div class="article-container">
        <section class="article-header">
          <div class="article-meta">
            <span>
              {formattedDate}
            </span>

            {
              location && (
                <span>
                  {location}
                </span>
              )
            }
          </div>

          <h1>
            {title}
          </h1>

          {
            description && (
              <p class="description">
                {description}
              </p>
            )
          }

          {
            tags.length > 0 && (
              <div class="article-tags">
                {
                  tags.map((tag) => (
                    <a
                      href={`${base}tags/${slugifyTag(tag)}/`}
                    >
                      #{tag}
                    </a>
                  ))
                }
              </div>
            )
          }

          <div
            class="rating"
            aria-label={`Rating: ${rating} out of 6`}
          >
            {stars}
          </div>
        </section>

        {
          coverUrl && (
            <button
              class="article-cover"
              id="coverButton"
              type="button"
              aria-label="Open full-size image"
            >
              <img
                src={coverUrl}
                alt={title}
              />
            </button>
          )
        }

        <article
          class="article-body"
          set:html={bodyHtml}
        />
      </div>
    </main>

    {
      coverFullUrl && (
        <div
          class="lightbox"
          id="coverLightbox"
          aria-hidden="true"
        >
          <button
            class="lightbox-backdrop"
            id="lightboxBackdrop"
            type="button"
            aria-label="Close image"
          >
          </button>

          <div class="lightbox-content">
            <button
              class="lightbox-close"
              id="lightboxClose"
              type="button"
            >
              CLOSE
            </button>

            <img
              src={coverFullUrl}
              alt={title}
              class="lightbox-image"
            />
          </div>
        </div>
      )
    }

    <footer class="site-footer">
      <span>
        FOR THE RECORD
      </span>

      <span>
        © 2026
      </span>
    </footer>

    <script>
      const coverButton =
        document.getElementById(
          "coverButton"
        );

      const lightbox =
        document.getElementById(
          "coverLightbox"
        );

      const lightboxClose =
        document.getElementById(
          "lightboxClose"
        );

      const lightboxBackdrop =
        document.getElementById(
          "lightboxBackdrop"
        );

      function openLightbox() {
        if (!lightbox) return;

        lightbox.classList.add(
          "open"
        );

        lightbox.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.classList.add(
          "lightbox-open"
        );
      }

      function closeLightbox() {
        if (!lightbox) return;

        lightbox.classList.remove(
          "open"
        );

        lightbox.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.classList.remove(
          "lightbox-open"
        );
      }

      coverButton?.addEventListener(
        "click",
        openLightbox
      );

      lightboxClose?.addEventListener(
        "click",
        closeLightbox
      );

      lightboxBackdrop?.addEventListener(
        "click",
        closeLightbox
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            closeLightbox();
          }
        }
      );
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        margin: 0;
        padding: 0;

        background: #ffffff;
      }

      :global(body) {
        margin: 0;
        padding: 0;

        background: #ffffff;
        color: #111111;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        -webkit-font-smoothing:
          antialiased;
      }

      :global(body.lightbox-open) {
        overflow: hidden;
      }

      .site-header {
        position: sticky;

        top: 0;
        z-index: 100;

        width:
          calc(100% - 24px);

        max-width: 1440px;
        height: 45px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content:
          space-between;

        border-bottom:
          1px solid #e5e5e5;

        background: #ffffff;
      }

      .logo {
        color: #111111;
        text-decoration: none;

        font-size: 14px;
        letter-spacing: -0.02em;
      }

      .back {
        color: #111111;
        text-decoration: none;

        font-size: 9px;
        letter-spacing: 0.08em;
      }

      .article-container {
        width:
          calc(100% - 24px);

        max-width: 1440px;

        margin: 0 auto;
      }

      .article-header {
        padding-top: 72px;
      }

      .article-meta {
        display: flex;
        gap: 30px;

        color: #777777;

        font-size: 9px;
        letter-spacing: 0.05em;
      }

      h1 {
        max-width: 1100px;

        margin:
          30px 0
          0;

        color: #111111;

        font-size:
          clamp(
            54px,
            7vw,
            92px
          );

        font-weight: 400;

        letter-spacing:
          -0.055em;

        line-height: 0.95;
      }

      .description {
        max-width: 800px;

        margin:
          35px 0
          0;

        color: #333333;

        font-size: 14px;
        line-height: 1.6;
      }

      .article-tags {
        display: flex;
        flex-wrap: wrap;

        gap: 10px;

        margin-top: 25px;
      }

      .article-tags a {
        color: #666666;
        text-decoration: none;

        font-size: 9px;
        letter-spacing: 0.03em;
      }

      .article-tags a:hover {
        color: #111111;
      }

      .rating {
        margin-top: 22px;

        color: #111111;

        font-size: 16px;
        letter-spacing: 0.12em;

        line-height: 1;
      }

      .article-cover {
        width: 100%;
        max-width: 680px;

        margin:
          60px 0
          0;

        padding: 0;
        border: 0;

        appearance: none;

        display: block;

        aspect-ratio: 16 / 9;

        background: #f4f4f4;

        overflow: hidden;

        cursor: zoom-in;
      }

      .article-cover img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
        object-position: center;
      }

      .article-body {
        width: 100%;
        max-width: 680px;

        margin-top: 65px;

        color: #111111;

        font-size: 15px;
        line-height: 2;

        text-align: left;
      }

      .article-body :global(p) {
        margin:
          0 0
          32px;
      }

      .article-body :global(h2) {
        margin:
          55px 0
          25px;

        font-size: 24px;
        font-weight: 400;

        letter-spacing: -0.02em;

        line-height: 1.3;
      }

      .article-body :global(h3) {
        margin:
          45px 0
          20px;

        font-size: 18px;
        font-weight: 400;
      }

      .article-body :global(.body-image) {
        width: 100%;

        margin:
          50px 0;
      }

      .article-body
        :global(.body-image img) {
        width: 100%;
        max-width: 100%;

        height: auto;

        display: block;

        margin: 0;

        background: #f4f4f4;
      }

      .article-body
        :global(.body-image figcaption) {
        margin-top: 10px;

        color: #777777;

        font-size: 10px;
        line-height: 1.6;
      }

      .article-body :global(a) {
        color: inherit;
      }

      .lightbox {
        position: fixed;

        inset: 0;

        z-index: 1000;

        display: none;
        align-items: center;
        justify-content: center;

        padding: 40px;

        background:
          rgba(
            255,
            255,
            255,
            0.96
          );
      }

      .lightbox.open {
        display: flex;
      }

      .lightbox-backdrop {
        position: absolute;

        inset: 0;

        width: 100%;
        height: 100%;

        padding: 0;
        border: 0;

        background: transparent;

        cursor: zoom-out;
      }

      .lightbox-content {
        position: relative;

        z-index: 2;

        max-width: 95vw;
        max-height: 95vh;

        display: flex;
        align-items: center;
        justify-content: center;
      }

      .lightbox-image {
        display: block;

        max-width: 95vw;
        max-height: 90vh;

        width: auto;
        height: auto;

        object-fit: contain;
      }

      .lightbox-close {
        position: absolute;

        top: -30px;
        right: 0;

        padding: 0;
        border: 0;

        background: transparent;

        color: #111111;

        font-family: inherit;

        font-size: 9px;
        letter-spacing: 0.08em;

        cursor: pointer;
      }

      .site-footer {
        width:
          calc(100% - 24px);

        max-width: 1440px;

        margin:
          120px auto
          0;

        padding:
          25px 0
          28px;

        border-top:
          1px solid #e5e5e5;

        display: flex;

        justify-content:
          space-between;

        color: #777777;

        font-size: 9px;
        letter-spacing: 0.06em;
      }

      @media (max-width: 800px) {
        .article-header {
          padding-top: 55px;
        }

        h1 {
          font-size: 50px;
        }

        .article-cover {
          max-width: 680px;
        }

        .article-body {
          font-size: 14px;
        }

        .lightbox {
          padding: 25px;
        }
      }

      @media (max-width: 600px) {
        .site-header {
          width:
            calc(100% - 40px);
        }

        .article-container {
          width:
            calc(100% - 40px);
        }

        .article-header {
          padding-top: 50px;
        }

        h1 {
          font-size: 42px;
        }

        .article-cover {
          width: 100%;
          max-width: none;

          margin-top: 50px;

          aspect-ratio: 4 / 3;
        }

        .article-body {
          width: 100%;
          max-width: none;

          margin-top: 50px;

          font-size: 14px;
        }

        .article-body
          :global(.body-image) {
          margin:
            35px 0;
        }

        .site-footer {
          width:
            calc(100% - 40px);
        }

        .lightbox {
          padding: 20px;
        }

        .lightbox-image {
          max-width: 92vw;
          max-height: 85vh;
        }

        .lightbox-close {
          top: -25px;
        }
      }
    </style>
  </body>
</html>