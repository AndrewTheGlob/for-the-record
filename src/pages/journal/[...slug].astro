---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("entries");

  return entries.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const {
  title,
  date,
  location,
  description,
  cover,
  tags,
  rating,
} = entry.data;

const formattedDate = date
  .toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  })
  .toUpperCase();

const base = import.meta.env.BASE_URL;

function slugifyTag(tag: string) {
  return tag
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^a-z0-9-]/g, "");
}

function withBase(path: string) {
  if (!path) return "";

  if (
    path.startsWith("http://") ||
    path.startsWith("https://")
  ) {
    return path;
  }

  return `${base}${path.replace(/^\/+/, "")}`;
}

const stars =
  "★".repeat(rating) +
  "☆".repeat(6 - rating);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title} — for the record</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>
    <header class="site-header">
      <a href={base} class="logo">
        for the record
      </a>

      <a href={base} class="back">
        BACK
      </a>
    </header>

    <main>

      <!-- =========================
           ARTICLE HEADER
      ========================= -->

      <section class="article-header">

        <div class="article-meta">
          <span>{formattedDate}</span>
          <span>{location}</span>
        </div>

        <h1>{title}</h1>

        <p class="description">
          {description}
        </p>

        {
          tags && tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <a
                  href={`${base}tags/${slugifyTag(tag)}/`}
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <div
          class="rating"
          aria-label={`Rating: ${rating} out of 6`}
        >
          {stars}
        </div>

      </section>


      <!-- =========================
           ARTICLE COVER
      ========================= -->

      {
        cover && (
          <div class="article-cover">
            <img
              src={withBase(cover)}
              alt={title}
            />
          </div>
        )
      }


      <!-- =========================
           ARTICLE CONTENT
      ========================= -->

      <article class="article-body">
        <Content />
      </article>

    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer class="site-footer">
      <span>FOR THE RECORD</span>
      <span>© 2026</span>
    </footer>


    <style>

      /* =========================
         GLOBAL
      ========================= */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        margin: 0;
        padding: 0;
        background: #ffffff;
      }

      :global(body) {
        margin: 0;
        padding: 0;

        background: #ffffff;
        color: #111111;

        font-family:
          Arial,
          Helvetica,
          sans-serif;

        -webkit-font-smoothing: antialiased;
      }


      /* =========================
         HEADER
      ========================= */

      .site-header {
        width: calc(100% - 24px);
        max-width: 1440px;

        height: 45px;

        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e5e5e5;
      }

      .logo {
        color: #111111;
        text-decoration: none;

        font-size: 14px;
        letter-spacing: -0.02em;
      }

      .back {
        color: #111111;
        text-decoration: none;

        font-size: 9px;
        letter-spacing: 0.08em;
      }


      /* =========================
         MAIN
      ========================= */

      main {
        width: 100%;
      }


      /* =========================
         ARTICLE HEADER
      ========================= */

      .article-header {
        width: calc(100% - 24px);
        max-width: 1440px;

        margin: 0 auto;

        padding-top: 72px;
      }

      .article-meta {
        display: flex;
        gap: 30px;

        color: #777777;

        font-size: 9px;
        letter-spacing: 0.05em;
      }

      h1 {
        margin: 30px 0 0;

        font-size: clamp(54px, 7vw, 92px);
        font-weight: 400;

        letter-spacing: -0.055em;
        line-height: 0.95;
      }

      .description {
        max-width: 800px;

        margin: 35px 0 0;

        color: #333333;

        font-size: 14px;
        line-height: 1.6;
      }

      .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;

        margin-top: 25px;
      }

      .article-tags a {
        color: #666666;
        text-decoration: none;

        font-size: 9px;
        letter-spacing: 0.03em;
      }

      .article-tags a:hover {
        color: #111111;
      }

      .rating {
        margin-top: 22px;

        color: #111111;

        font-size: 16px;
        letter-spacing: 0.12em;
        line-height: 1;
      }


      /* =========================
         ARTICLE COVER
      ========================= */

      .article-cover {
        width: calc(100% - 24px);
        max-width: 760px;

        margin: 70px 12px 0;

        aspect-ratio: 16 / 9;

        background: #f4f4f4;

        overflow: hidden;
      }

      .article-cover img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
        object-position: center;
      }


      /* =========================
         ARTICLE BODY
      ========================= */

      .article-body {
        width: calc(100% - 24px);
        max-width: 680px;

        margin: 70px 12px 0;

        color: #111111;

        font-size: 15px;
        line-height: 2;

        text-align: left;
      }

      .article-body :global(p) {
        margin: 0 0 32px;
      }

      .article-body :global(h2) {
        margin: 55px 0 25px;

        font-size: 24px;
        font-weight: 400;

        letter-spacing: -0.02em;
        line-height: 1.3;
      }

      .article-body :global(h3) {
        margin: 45px 0 20px;

        font-size: 18px;
        font-weight: 400;
      }


      /* =========================
         ARTICLE BODY IMAGES
      ========================= */

      .article-body :global(img) {
        width: 100%;
        max-width: 680px;
        height: auto;

        display: block;

        margin: 50px 0;

        object-fit: cover;

        background: #f4f4f4;
      }

      .article-body :global(a) {
        color: inherit;
      }


      /* =========================
         FOOTER
      ========================= */

      .site-footer {
        width: calc(100% - 24px);
        max-width: 1440px;

        margin: 120px auto 0;

        padding: 25px 0 28px;

        border-top: 1px solid #e5e5e5;

        display: flex;
        justify-content: space-between;

        color: #777777;

        font-size: 9px;
        letter-spacing: 0.06em;
      }


      /* =========================
         TABLET
      ========================= */

      @media (max-width: 800px) {

        .article-header {
          padding-top: 55px;
        }

        h1 {
          font-size: 50px;
        }

        .article-cover {
          max-width: 680px;
        }

        .article-body {
          font-size: 14px;
        }

      }


      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 600px) {

        .site-header {
          width: calc(100% - 40px);
        }

        .article-header {
          width: calc(100% - 40px);

          padding-top: 50px;
        }

        .article-cover {
          width: calc(100% - 40px);
          max-width: none;

          margin:
            55px 20px
            0;

          aspect-ratio: 4 / 3;
        }

        .article-body {
          width: calc(100% - 40px);
          max-width: none;

          margin:
            55px 20px
            0;

          font-size: 14px;
        }

        .article-body :global(img) {
          width: 100%;
          max-width: none;

          margin: 35px 0;
        }

        h1 {
          font-size: 42px;
        }

        .site-footer {
          width: calc(100% - 40px);
        }

      }

    </style>
  </body>
</html>
